{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KaarjooCompanyDirectory",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "domain",
      "atsType",
      "boardSlug",
      "boardUrl",
      "country",
      "active"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "domain": {
        "type": "string"
      },
      "atsType": {
        "type": "string"
      },
      "boardSlug": {
        "type": "string"
      },
      "boardUrl": {
        "type": "string",
        "format": "uri"
      },
      "country": {
        "type": "string"
      },
      "headquarters": {
        "type": "string"
      },
      "industry": {
        "type": "string"
      },
      "active": {
        "type": "boolean"
      },
      "lastSyncedAt": {
        "type": "string"
      },
      "jobCount": {
        "type": "number"
      },
      "logoUrl": {
        "type": "string"
      },
      "sizeBucket": {
        "type": "string",
        "enum": [
          "1-10",
          "11-50",
          "51-200",
          "201-500",
          "501-1000",
          "1000+"
        ]
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "remotePolicy": {
        "type": "string",
        "enum": [
          "remote-first",
          "hybrid",
          "on-site",
          "flexible"
        ]
      },
      "isFollowed": {
        "type": "boolean"
      }
    }
  }
}