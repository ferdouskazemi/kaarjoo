<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Node.js V8 JIT and WebAssembly execution in the engine sidecar -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required to load native addons (.node) and dynamic frameworks inside the bundle -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Required for public ATS job board crawling and updater manifest checks -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Required for user-selected résumé files and exported PDFs/DOCXs -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
